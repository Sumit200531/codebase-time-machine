{
  "name": "codebase-time-machine",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "tsx packages/cli/src/main.ts",
    "verify": "tsx scripts/verify-against-git.ts",
    "demo:build": "tsx scripts/create-taskflow.ts",
    "dev": "npm run dev -w @ctm/web",
    "build:web": "npm run build -w @ctm/web"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
